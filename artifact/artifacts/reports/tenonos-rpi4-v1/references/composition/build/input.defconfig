CONFIG_ARCH_ARM_64=y
CONFIG_MCPU_ARM64_CORTEX_A72=y
# CONFIG_ARM64_ERRATUM_858921 is not set
# CONFIG_ARM64_ERRATUM_835769 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
CONFIG_PLAT_KVM=y
CONFIG_FPSIMD=y
CONFIG_VIRTUALIZE_PLAT_MEM_SIZE=0x8000000
CONFIG_LIBUKLOCK=y
# CONFIG_LIBUKLOCK_MUTEX is not set
# CONFIG_LIBUKLOCK_RWLOCK is not set
CONFIG_LIBTNSYSTICK_FREQ=1000
CONFIG_LIBUKBOOT_INITSCHEDPRIO=y
CONFIG_LIBTNSCHEDPRIO_ENABLE_PREEMTIVE=y
CONFIG_LIBUKBOOT_INITTLSF=y
CONFIG_TLSF_LOG2_SLI=2
