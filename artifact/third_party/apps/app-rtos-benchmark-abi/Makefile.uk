$(eval $(call addlib,apprhealstonebenchmark))

CINCLUDES-y     += -I$(APPRHEALSTONEBENCHMARK_BASE)/include
CXXINCLUDES-y   += -I$(APPRHEALSTONEBENCHMARK_BASE)/include

APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/time/armcycle/rst_time.c

APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_isr.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_sem.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_task.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_yield.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_reschedule.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_irq.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/adapter/os/tenonos/rst_tick.c


APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_semaphore_shuffle.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_task_preempt.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_task_switch.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_interrupt_latency.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_task_switch_multi_threaded.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/src/rst_set_timer_offset.c
APPRHEALSTONEBENCHMARK_SRCS-y += $(APPRHEALSTONEBENCHMARK_BASE)/main.c
